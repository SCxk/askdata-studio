  {
    "case_id": "SCHOOL-004",
    "query": "八年级期末数学得分率最低的知识点有哪些？",
    "gold_sql": "SELECT k.knowledge_name, COUNT(*) AS answered_question_persons,\n               ROUND(100.0*SUM(r.score)/SUM(q.max_score),2) AS score_rate_pct\n        FROM question_responses r JOIN exam_questions q USING(question_id)\n        JOIN knowledge_points k USING(knowledge_id) JOIN exams x USING(exam_id)\n        WHERE x.grade=8 AND x.subject_id='MAT' AND x.exam_type='final'\n        GROUP BY 1 ORDER BY score_rate_pct, k.knowledge_name",
    "expected_rows": [
      {
        "knowledge_name": "勾股定理",
        "answered_question_persons": 1020,
        "score_rate_pct": 66.81
      },
      {
        "knowledge_name": "二次根式",
        "answered_question_persons": 1020,
        "score_rate_pct": 68.62
      },
      {
        "knowledge_name": "平行四边形",
        "answered_question_persons": 1020,
        "score_rate_pct": 71.08
      },
      {
        "knowledge_name": "一次函数",
        "answered_question_persons": 1020,
        "score_rate_pct": 73.05
      },
      {
        "knowledge_name": "数据分析",
        "answered_question_persons": 1020,
        "score_rate_pct": 75.14
      }
    ],
    "order_sensitive": true
  },
  {
    "case_id": "SCHOOL-005",
    "query": "七年级各班数学从三月到期末平均进步多少？只比较两次均实考的学生。",
    "gold_sql": "WITH paired AS (\n            SELECT r.enrollment_id,\n                   MAX(CASE WHEN x.exam_type='monthly' THEN 100*r.score/x.max_score END) AS baseline,\n                   MAX(CASE WHEN x.exam_type='final' THEN 100*r.score/x.max_score END) AS final_score\n            FROM exam_results r JOIN exams x USING(exam_id)\n            WHERE x.grade=7 AND x.subject_id='MAT' AND r.exam_status='attended'\n            GROUP BY r.enrollment_id\n        )\n        SELECT c.class_name, COUNT(*) AS paired_students,\n               ROUND(AVG(p.final_score-p.baseline),2) AS percentage_point_change\n        FROM paired p JOIN enrollments e USING(enrollment_id) JOIN classes c USING(class_id)\n        WHERE p.baseline IS NOT NULL AND p.final_score IS NOT NULL GROUP BY 1 ORDER BY 1",
    "expected_rows": [
      {
        "class_name": "七年级1班",
        "paired_students": 41,
        "percentage_point_change": 6.5
      },
      {
        "class_name": "七年级2班",
        "paired_students": 41,
        "percentage_point_change": 7.37
      },
      {
        "class_name": "七年级3班",
        "paired_students": 41,
        "percentage_point_change": 6.28
      },
      {
        "class_name": "七年级4班",
        "paired_students": 45,
        "percentage_point_change": 9.4
      },
      {
        "class_name": "七年级5班",
        "paired_students": 42,
        "percentage_point_change": 8.26
      },
      {
        "class_name": "七年级6班",
        "paired_students": 40,
        "percentage_point_change": 5.77
      }
    ],
    "order_sensitive": true
  },
