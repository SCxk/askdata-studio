  {
    "case_id": "SCHOOL-001",
    "query": "八年级期中数学各班平均分、及格率和缺考人数是多少？",
    "gold_sql": "SELECT c.class_name, COUNT(*) AS expected_students,\n               COUNT(r.score) AS attended_students,\n               COUNT(*) FILTER (WHERE r.exam_status='absent') AS absent_students,\n               ROUND(AVG(r.score), 2) AS average_score,\n               ROUND(100.0*COUNT(*) FILTER (WHERE r.score/x.max_score>=s.pass_ratio)\n                     /NULLIF(COUNT(r.score),0),2) AS pass_rate_pct\n        FROM exam_results r JOIN exams x USING(exam_id)\n        JOIN enrollments e USING(enrollment_id) JOIN classes c USING(class_id)\n        JOIN subjects s ON x.subject_id=s.subject_id\n        WHERE x.grade=8 AND x.subject_id='MAT' AND x.exam_type='midterm'\n        GROUP BY c.class_name ORDER BY c.class_name",
    "expected_rows": [
      {
        "class_name": "八年级1班",
        "expected_students": 44,
        "attended_students": 43,
        "absent_students": 1,
        "average_score": 77.94,
        "pass_rate_pct": 69.77
      },
      {
        "class_name": "八年级2班",
        "expected_students": 43,
        "attended_students": 41,
        "absent_students": 2,
        "average_score": 80.76,
        "pass_rate_pct": 75.61
      },
      {
        "class_name": "八年级3班",
        "expected_students": 42,
        "attended_students": 39,
        "absent_students": 3,
        "average_score": 75.81,
        "pass_rate_pct": 61.54
      },
      {
        "class_name": "八年级4班",
        "expected_students": 43,
        "attended_students": 42,
        "absent_students": 1,
        "average_score": 79.24,
        "pass_rate_pct": 61.9
      },
      {
        "class_name": "八年级5班",
        "expected_students": 44,
        "attended_students": 43,
        "absent_students": 1,
        "average_score": 81.09,
        "pass_rate_pct": 76.74
      },
      {
        "class_name": "八年级6班",
        "expected_students": 43,
        "attended_students": 42,
        "absent_students": 1,
